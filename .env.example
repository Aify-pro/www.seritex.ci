# URL publique du site (balises SEO, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.seritex.ci

# Application Seritex (lien « Espace client »)
NEXT_PUBLIC_APP_URL=https://app.seritex.ci

# Même projet Supabase que l'application. Clé « service role » : SERVEUR UNIQUEMENT,
# ne jamais la préfixer par NEXT_PUBLIC_. Sert à enregistrer les demandes de devis
# et à lire le catalogue publiable (eshop_catalogue, migration 0108 de l'application).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Clé « anon » (publique par conception, la protection vient de la RLS) : sert UNIQUEMENT
# à l'authentification des comptes de l'e-shop (inscription, connexion). Sans elle, les
# comptes sont indisponibles et l'envoi d'une composition est refusé. SERVEUR UNIQUEMENT.
SUPABASE_ANON_KEY=
